rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is Lifetime Super Admin
    function isSuperAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'mejennur669@gmail.com' ||
         request.auth.token.email == 'abuzinad7862@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')));
    }

    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile: students can only read and update their own canonical profile, Super Admin has full write access
    match /users/{userId} {
      // Users must only access their own protected data unless verified Super Admin
      allow read: if isOwner(userId) || isSuperAdmin();
      // Only the authenticated user can create their own profile under their auth.uid
      // Regular users are blocked from self-elevating to admin or super_admin
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'student' ||
        isSuperAdmin()
      );
      // Students CANNOT change their grade, role, or premium status on their own
      allow update: if isSuperAdmin() ||
        (isOwner(userId) &&
         request.resource.data.grade == resource.data.grade &&
         request.resource.data.role == resource.data.role &&
         (!('isPremium' in request.resource.data) || request.resource.data.isPremium == resource.data.isPremium));
      allow delete: if isSuperAdmin();

      // Student subcollections for progress and quiz records
      match /progress/{progressId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
      match /quizRecords/{quizId} {
        allow read, write: if isOwner(userId) || isSuperAdmin();
      }
    }

    // User Identity Migration Backups: Readable and writable only by Super Admin
    match /users_migration_backup/{backupId} {
      allow read, write: if isSuperAdmin();
    }

    // Curriculum subjects, units, topics, textbooks: Publicly readable by all students, writable only by Super Admin
    match /curriculum_subjects/{subjectId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /curriculum_units/{unitId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /curriculum_topics/{topicId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /textbooks/{textbookId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Quizzes & Exam attempts: Students can create their own attempts and read them
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Submissions: Students submit and read their own, Super Admin can grade and view all
    match /submissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // Payments: Users can create and read their own transactions, Super Admin can verify & approve
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.studentId == request.auth.uid || 
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // Assignment & STEM submissions: Students submit and read their own, Super Admin can grade
    match /assignment_submissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }
    match /stem_project_submissions/{subId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // Subscriptions & Entitlements: Read own, modified only by Super Admin upon verification
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }
    match /entitlements/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // System Pricing & Payment Accounts: Publicly readable, modifiable only by Super Admin
    match /pricing_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /payment_accounts/{accId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Security & Payment Audit Logs: Append-only for system, readable only by Super Admin
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if false; // Append-only immutability
    }
    match /payment_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() || isSuperAdmin();
      allow update, delete: if false; // Append-only immutability
    }

    // Feedback: Any user can submit, only Super Admin can view/resolve
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // Fallback rule for all other collections
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
